# Internal Portal Environment Variables

# Cognito User Pool Configuration
VITE_COGNITO_AUTHORITY=https://cognito-idp.eu-west-2.amazonaws.com/{UserPoolId}
VITE_COGNITO_CLIENT_ID={InternalPortalClientId}
VITE_COGNITO_DOMAIN=project-faultline-demo.auth.eu-west-2.amazoncognito.com
VITE_COGNITO_REDIRECT_URI=http://localhost:5173/callback
VITE_COGNITO_POST_LOGOUT_REDIRECT_URI=http://localhost:5173

# API Configuration
VITE_API_URL=http://localhost:3000
