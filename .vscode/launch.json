{
  "configurations": [
    {
      "name": "Attach to SAM Local API",
      "type": "go",
      "request": "attach",
      "mode": "remote",
      "host": "localhost",
      "port": 5986,
      "substitutePath": [
        {
          "from": "${workspaceFolder}/api",
          "to": "${workspaceFolder}/api"
        }
      ]
    }
  ]
}
